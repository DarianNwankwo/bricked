{
  "name": "brick-cli",
  "version": "0.2.0",
  "description": "Translate natural language or Mermaid diagrams into deployed DigitalOcean infrastructure",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "brick": "./dist/bin/brick.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:frontend": "cd frontend && npm run build",
    "build:all": "tsc && cd frontend && npm run build",
    "dev": "tsx bin/brick.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "start": "node dist/bin/brick.js",
    "test": "vitest",
    "test:run": "vitest run",
    "worker": "tsx src/worker/index.ts",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run test:run && npm run build"
  },
  "keywords": [
    "cli",
    "digitalocean",
    "infrastructure",
    "mermaid",
    "deployment"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@octokit/rest": "^22.0.1",
    "better-sqlite3": "^12.6.2",
    "bullmq": "^5.69.2",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "inquirer": "^9.2.0",
    "ioredis": "^5.9.2",
    "openai": "^6.17.0",
    "ora": "^8.0.0",
    "pg": "^8.18.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "y-websocket": "^3.0.0",
    "yaml": "^2.4.0",
    "yjs": "^13.6.29"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.16.0",
    "puppeteer": "^24.37.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
